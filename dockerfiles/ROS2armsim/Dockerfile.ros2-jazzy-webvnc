# syntax=docker/dockerfile:1.4
## ROS2 Jazzy + MoveIt Simulation Container with Web VNC Access
## Based on official OSRF ROS2 Jazzy image (Ubuntu 24.04 Noble)
## Adds XFCE desktop + TigerVNC + noVNC for browser-based access

FROM osrf/ros:jazzy-desktop-full

ENV ROS_DISTRO=jazzy
ARG DEBIAN_FRONTEND=noninteractive
ENV USER=ros
ENV PASSWORD=ros
ENV HOME=/home/ros
ENV PUID=1001
ENV PGID=1001

## Web VNC ports
EXPOSE 3000 5901

## Install desktop environment, VNC server, and web VNC
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked     --mount=type=cache,target=/var/lib/apt,sharing=locked     apt-get update && apt-get install -y     xfce4 xfce4-goodies xfce4-terminal     dbus-x11     libgl1 libglx-mesa0 libgl1-mesa-dri mesa-utils     tigervnc-standalone-server tigervnc-viewer     novnc websockify     python3-websockify     curl wget git     gnupg2 lsb-release software-properties-common     sudo     && rm -rf /var/lib/apt/lists/*

## Install noVNC web interface files
RUN mkdir -p /usr/share/novnc     && cp -r /usr/share/novnc/utils /usr/share/novnc/ 2>/dev/null || true     && ln -sf /usr/share/novnc /usr/share/novnc/www 2>/dev/null || true

## Create user with UID 1001 (avoid conflict with existing UID 1000 in base image)
RUN useradd -m -s /bin/bash -u ${PUID} -g ${PGID} ${USER} || groupadd -g ${PGID} ${USER} && useradd -m -s /bin/bash -u ${PUID} -g ${PGID} ${USER}     && echo "${USER}:${PASSWORD}" | chpasswd     && usermod -aG sudo ${USER}     && echo "${USER} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

## Setup VNC configuration
RUN mkdir -p ${HOME}/.vnc     && echo "${PASSWORD}" | vncpasswd -f > ${HOME}/.vnc/passwd     && chmod 600 ${HOME}/.vnc/passwd     && chown -R ${USER}:${USER} ${HOME}

## Create VNC startup script that launches XFCE
RUN echo '#!/bin/bash\n\nunset SESSION_MANAGER\nunset DBUS_SESSION_BUS_ADDRESS\nexec startxfce4\n' > ${HOME}/.vnc/xstartup     && chmod +x ${HOME}/.vnc/xstartup     && chown -R ${USER}:${USER} ${HOME}/.vnc

## Install additional ROS2 packages needed for MoveIt and UR robot
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked     --mount=type=cache,target=/var/lib/apt,sharing=locked     apt-get update && apt-get install -y     ros-${ROS_DISTRO}-moveit     ros-${ROS_DISTRO}-ur     ros-${ROS_DISTRO}-ur-robot-driver     ros-${ROS_DISTRO}-ur-moveit-config     python3-rosdep     python3-colcon-common-extensions     python3-colcon-mixin     python3-vcstool     build-essential     cmake     ccache     && rm -rf /var/lib/apt/lists/*

## Initialize rosdep
RUN rosdep init || true && rosdep update || true

## Create workspace
RUN mkdir -p /opt/ws_moveit/src     && chown -R ${USER}:${USER} /opt/ws_moveit

## Clone MoveIt tutorials
RUN --mount=type=cache,target=/tmp/git-cache,sharing=locked     cd /opt/ws_moveit/src     && git clone https://github.com/moveit/moveit2_tutorials     && echo "Tutorials cloned successfully"

## Import dependencies
RUN --mount=type=cache,target=/tmp/git-cache,sharing=locked     cd /opt/ws_moveit/src     && vcs import --recursive < moveit2_tutorials/moveit2_tutorials.repos     && echo "Dependencies imported successfully"

## Install workspace dependencies
RUN cd /opt/ws_moveit     && rosdep install -r --from-paths . --ignore-src --rosdistro ${ROS_DISTRO} -y     || echo "Some rosdep dependencies failed, continuing..."

## Build workspace
RUN --mount=type=cache,target=/tmp/ccache,sharing=locked     /bin/bash -c "export CCACHE_DIR=/tmp/ccache     && source /opt/ros/${ROS_DISTRO}/setup.bash     && cd /opt/ws_moveit     && colcon build         --executor sequential         --parallel-workers 1         --cmake-args -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER_LAUNCHER=ccache         --event-handlers console_direct+     && echo 'Build completed successfully'"     || echo "Build may have had issues, continuing..."

## Set permissions
RUN chown -R ${USER}:${USER} /opt/ws_moveit     && chmod -R 755 /opt/ws_moveit

## Setup ROS environment in bashrc
RUN echo 'source /opt/ros/'${ROS_DISTRO}'/setup.bash' >> ${HOME}/.bashrc     && echo '[ -f /opt/ws_moveit/install/setup.bash ] && source /opt/ws_moveit/install/setup.bash' >> ${HOME}/.bashrc

## Create startup scripts
RUN echo '#!/bin/bash\nsleep 5\nsource /opt/ros/'${ROS_DISTRO}'/setup.bash\nif [ -f /opt/ws_moveit/install/setup.bash ]; then\n    source /opt/ws_moveit/install/setup.bash\nfi\necho "Starting UR5e control stack (mock hardware)..."\nros2 launch ur_robot_driver ur_control.launch.py \\*n    ur_type:=ur5e \\*n    use_mock_hardware:=true \\*n    robot_ip:=0.0.0.0 \\*n    launch_rviz:=false &\necho "Waiting for scaled_joint_trajectory_controller to become active..."\nuntil ros2 control list_controllers 2>/dev/null | grep -q "scaled_joint_trajectory_controller.*active"; do\n    sleep 1\ndone\necho "Controllers ready. Launching MoveIt + RViz..."\nros2 launch ur_moveit_config ur_moveit.launch.py \\*n    ur_type:=ur5e \\*n    launch_rviz:=true\n' > /usr/local/bin/start-demo.sh     && chmod +x /usr/local/bin/start-demo.sh

## Create the main entrypoint script that starts VNC + noVNC + demo
RUN echo '#!/bin/bash\n\n# Start D-Bus\nmkdir -p /var/run/dbus\ndbus-daemon --system --fork 2>/dev/null || true\n\n# Start VNC server\nsu - ${USER} -c "vncserver :1 -geometry 1920x1080 -depth 24 -localhost no"\n\n# Start noVNC web server (port 3000 to match webtop convention)\nwebsockify --web=/usr/share/novnc --cert=none --ssl-only=false 3000 localhost:5901 &\n\necho "========================================"\necho "ROS2 Jazzy + MoveIt Web VNC Container"\necho "========================================"\necho "noVNC Web Interface: http://localhost:3000"\necho "VNC Direct: localhost:5901"\necho "Password: ${PASSWORD}"\necho "========================================"\n\n# Start the demo if requested\nif [ "${AUTO_START_DEMO}" = "true" ]; then\n    sleep 10\n    su - ${USER} -c "/usr/local/bin/start-demo.sh" &\nfi\n\n# Keep container running\ntail -f /dev/null\n' > /usr/local/bin/entrypoint.sh     && chmod +x /usr/local/bin/entrypoint.sh

## Environment settings
ENV DBUS_SESSION_BUS_ADDRESS=unix:path=/dev/null
ENV NO_AT_BRIDGE=1
ENV CCACHE_DIR=/tmp/ccache
ENV DISPLAY=:1

## Switch to ros user for runtime
USER ${USER}
WORKDIR ${HOME}

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]